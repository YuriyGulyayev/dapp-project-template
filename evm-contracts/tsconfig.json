{
   "compilerOptions": {
      "lib": ["es2025"],
      "module": "node20",
      "target": "es2025",
      "skipLibCheck": true,
      "noEmit": true,
      "allowImportingTsExtensions": true,
      "types": ["node", "mocha"],
      "verbatimModuleSyntax": true
   },
   "include": ["**/*.ts"],
   "exclude": ["**/node_modules/**"]
}
