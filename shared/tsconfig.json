{
   "compilerOptions": {
      "lib": ["es2025"],
      "module": "node20",
      "target": "es2025",
      "types": ["node", "mocha"],
      "noEmit": true,
      "allowImportingTsExtensions": true,
      "erasableSyntaxOnly": true,
      "strict": true,
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "verbatimModuleSyntax": true
   },
   "include": ["**/*.ts"],
   "exclude": ["**/node_modules/**"]
}
